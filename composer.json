{
    "name": "flyo/nitro-php",
    "description": "Flyo Nitro PHP SDK",
    "keywords": [
        "flyo",
        "nitro",
        "headless"
    ],
    "homepage": "https://docs.flyo.cloud",
    "license": "mit",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^1.12"
    },
    "bin": [
        "bin/flyo-generate-blocks"
    ],
    "autoload": {
        "psr-4": {
            "Flyo\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flyo\\Test\\": "test/"
        },
        "exclude-from-classmap": [
            "/test/fixtures/"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": [
            "@phpstan-lib",
            "@phpstan-generator",
            "@phpstan-generated"
        ],
        "phpstan-lib": "vendor/bin/phpstan -v",
        "phpstan-generator": "vendor/bin/phpstan analyse -c phpstan-generator.neon -v",
        "phpstan-generated": "vendor/bin/phpstan analyse -c phpstan-generated.neon -v"
    }
}
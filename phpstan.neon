parameters:
  level: 2
  paths:
    - lib
  tmpDir: .tmp
  ignoreErrors:
    -
      identifier: binaryOp.invalid
    # Models generated from a schema without properties (currently MetaImage)
    # get an empty constructor, therefore $data is never read.
    -
      identifier: constructor.unusedParameter
      path: lib/Model/*.php
      reportUnmatched: false